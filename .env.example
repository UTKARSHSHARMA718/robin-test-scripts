# Express
PORT=3000

# pad-mcp (Docker: http://localhost:8080/mcp)
MCP_URL=http://localhost:8080/mcp
PAD_MCP_TOKEN=

# Which LLM adapter to use: openai | gemini | custom
LLM_PROVIDER=openai

# OpenAI (first tests)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional default when UI model field is empty
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (testing)
GEMINI_API_KEY=
# Optional proxy / alternate endpoint
# GEMINI_BASE_URL=
# Optional default when UI model field is empty
GEMINI_MODEL=gemini-2.0-flash

# Self-hosted API (later)
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
# Optional default when UI model field is empty
CUSTOM_LLM_MODEL=

# Optional: cap tool+LLM loop steps
AGENT_MAX_STEPS=20
